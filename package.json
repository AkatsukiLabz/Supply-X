{
  "name": "supply-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
  "server": "node --env-file-if-exists=.env server/index.js",
  "client": "vite --host 127.0.0.1",
  "dev": "concurrently -k \"npm run server\" \"npm run client\"",
  "build": "vite build",
  "check": "npm run build",
  "format": "prettier --write server client/src vite.config.js package.json README.md docs/*.md"
},
"dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "supabase": "^2.118.0",
    "vite": "^7.0.0"
  }
}